import java.util.ArrayList;
import java.util.Collections;

// ChestSortingSystem
// Created by William Neely, November 2026.
// This project uses the Comparable interface to sort different types of chests.


// Original StorageChest class.
// This is the parent class that the other two classes extend.
// It also implements Comparable so all chest types can be sorted.

class StorageChest implements Comparable<StorageChest> {

    // These variables store the basic information about a chest.
    private String color;
    private String material;
    private int itemCount;

    // Constructor sets the starting information.
    public StorageChest(String color, String material, int itemCount) {
        this.color = color;
        this.material = material;
        this.itemCount = itemCount;
    }

    // This method lets us change the chest's information.
    public void changeChest(String color, String material, int itemCount) {
        this.color = color;
        this.material = material;
        this.itemCount = itemCount;
    }

    // This method decides how chests are sorted.
    // Chests with fewer items come first.
    // If the item count matches, chests are sorted by color,
    // then material, and finally by class name to keep the ordering total.
    @Override
    public int compareTo(StorageChest other) {

        // Compare the number of items in each chest.
        int result = Integer.compare(this.itemCount, other.itemCount);
        if (result != 0) {
            return result;
        }

        // If both chests have the same item count,
        // sort them alphabetically by color.
        result = this.color.compareToIgnoreCase(other.color);
        if (result != 0) {
            return result;
        }

        // Use material as a secondary tie-breaker so chests with the
        // same count and color still have a consistent order.
        result = this.material.compareToIgnoreCase(other.material);
        if (result != 0) {
            return result;
        }

        // Final tie-breaker for a fully deterministic ordering.
        return this.getClass().getName().compareTo(other.getClass().getName());
    }

    // Prints the chest's information.
    @Override
    public String toString() {
        return "Color: " + color
             + ", Material: " + material
             + ", Items: " + itemCount;
    }
}


// TreasureChest is the first new class.
// It extends StorageChest and inherits its original features.

class TreasureChest extends StorageChest {

    // These variables hold the treasure chest's new information.
    private int goldCoins;
    private int treasureValue;

    // Constructor creates a treasure chest.
    public TreasureChest(String color, String material, int itemCount,
                         int goldCoins, int treasureValue) {

        // Get the original information from StorageChest.
        super(color, material, itemCount);

        // Set the new treasure information.
        this.goldCoins = goldCoins;
        this.treasureValue = treasureValue;
    }

    // This method adds coins to the treasure chest.
    public void addCoins(int coins) {
        goldCoins += coins;
    }

    // Prints the original information and new treasure information.
    @Override
    public String toString() {
        return super.toString()
             + ", Gold Coins: " + goldCoins
             + ", Treasure Value: $" + treasureValue;
    }
}


// SupplyChest is the second new class.
// It also extends StorageChest.

class SupplyChest extends StorageChest {

    // This array stores up to five different supplies.
    private String[] supplies = new String[5];

    // Tracks how many supplies have been added.
    private int supplyCount = 0;

    // Constructor creates a supply chest.
    public SupplyChest(String color, String material, int itemCount) {
        super(color, material, itemCount);
    }

    // This method adds supplies to the array.
    public void addSupply(String supply) {

        // Check if there is room for another supply.
        if (supplyCount < supplies.length) {
            supplies[supplyCount] = supply;
            supplyCount++;
        } else {
            System.out.println("The supply chest is full!");
        }
    }

    // Prints the original information and all the supplies.
    @Override
    public String toString() {

        String result = super.toString() + ", Supplies: ";

        // Loop through the array and print each supply.
        for (int i = 0; i < supplyCount; i++) {
            result += supplies[i];

            if (i < supplyCount - 1) {
                result += ", ";
            }
        }

        return result;
    }
}


// Main ChestSortingSystem class.
// This creates, changes, prints, and sorts all ten chests.

public class ChestSortingSystem {

    public static void main(String[] args) {

        // Create the original three types of chest.
        StorageChest chest = new StorageChest("Brown", "Wood", 5);

        TreasureChest treasure = new TreasureChest(
            "Gold", "Iron", 10, 100, 500
        );

        SupplyChest supplies = new SupplyChest(
            "Blue", "Wood", 3
        );

        // Change the original storage chest.
        chest.changeChest("Green", "Oak", 7);

        // Add coins to the treasure chest.
        treasure.addCoins(50);

        // Add supplies to the supply chest.
        supplies.addSupply("Food");
        supplies.addSupply("Water");
        supplies.addSupply("Tools");


        // Create seven more chests.

        StorageChest chest2 = new StorageChest("Red", "Steel", 12);

        TreasureChest treasure2 = new TreasureChest(
            "Purple", "Gold", 7, 200, 1000
        );

        SupplyChest supplies2 = new SupplyChest(
            "Gray", "Metal", 8
        );

        StorageChest chest3 = new StorageChest("Yellow", "Pine", 2);

        TreasureChest treasure3 = new TreasureChest(
            "Silver", "Iron", 15, 300, 2500
        );

        SupplyChest supplies3 = new SupplyChest(
            "Brown", "Wood", 6
        );

        StorageChest chest4 = new StorageChest("Black", "Stone", 9);


        // Add supplies to the other supply chests.
        supplies2.addSupply("Medicine");
        supplies2.addSupply("Bandages");

        supplies3.addSupply("Rope");
        supplies3.addSupply("Flashlight");


        // Create an ArrayList that stores any type of StorageChest.
        // TreasureChest and SupplyChest can also be stored here
        // because they extend StorageChest.

        ArrayList<StorageChest> chests = new ArrayList<>();

        // Add all ten chest objects to the ArrayList.
        chests.add(chest);
        chests.add(treasure);
        chests.add(supplies);
        chests.add(chest2);
        chests.add(treasure2);
        chests.add(supplies2);
        chests.add(chest3);
        chests.add(treasure3);
        chests.add(supplies3);
        chests.add(chest4);


        // Print all the chests before sorting.
        System.out.println("Chests Before Sorting:");

        for (StorageChest currentChest : chests) {
            System.out.println(currentChest);
        }


        // Sort all the chests using the Comparable interface.
        // Collections.sort() automatically uses compareTo().
        Collections.sort(chests);


        // Print all the chests after sorting.
        System.out.println("\nChests After Sorting:");

        for (StorageChest currentChest : chests) {
            System.out.println(currentChest);
        }
    }
}

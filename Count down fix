class main{
    public static final String ANSI_BLUE = "\u001B[34m";  // blue
    public static final String ANSI_RED = "\u001B[31m";   // red
    public static final String ANSI_GREEN = "\u001B[32m"; // green
    public static final String ANSI_RESET = "\u001B[0m";  // reset

    public static void main(String[] args) throws InterruptedException {

        // Create an array of size 100
        int[] numbers = new int[100];

        // Use a for loop to put the numbers 1 to 100 into the array
        for (int i = 0; i < numbers.length; i++) {
            numbers[i] = i + 1;
        }

        int sum = 0; // Keeps track of the sum of all numbers

        // Use another loop to go through the array
        for (int i = 0; i < numbers.length; i++) {

            // Add the current number to the running sum
            sum += numbers[i];

            // Check if the number is even or odd
            if (numbers[i] % 2 == 0) {
                System.out.println(ANSI_GREEN + numbers[i] + " is even" + ANSI_RESET);
            } else {
                System.out.println(ANSI_RED + numbers[i] + " is odd" + ANSI_RESET);
            }

            // Wait however many milliseconds before printing the next number
            Thread.sleep(100);
        }

        // Print the total after the loop finishes
        System.out.println(ANSI_BLUE + "The sum of numbers in total is: " + sum + ANSI_RESET);
    }
}
